@@META
title=Neon Coffre-fort
icon=<svg viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="3" width="26" height="26" rx="6" fill="#2f4553"/><circle cx="16" cy="16" r="8" fill="#1f3140"/><circle cx="16" cy="16" r="3" fill="#0a1626"/><path d="M16 4.5 l3 4 h-6z" fill="#2cf0c2"/></svg>
a=Neon
b=Coffre-fort
key=neon-safe-v1
keyhint=miser / encaisser — Entrée : valider · ← → : tourner · R : au hasard
lib=https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js
@@CSS
.sfwrap{position:relative;width:min(100%,560px);margin:0 auto}
.scene{position:relative;width:100%;aspect-ratio:1/0.92;border-radius:22px;overflow:hidden;background:radial-gradient(90% 80% at 50% 35%,#16244a,#070d1c 75%);border:1px solid var(--line);touch-action:none;cursor:grab;user-select:none;-webkit-user-select:none}
.scene.drag{cursor:grabbing}
.scene.off{cursor:default}
.scene canvas{display:block;width:100%;height:100%}
.nopanel{display:flex;align-items:center;justify-content:center;gap:14px}
.center{display:flex;flex-direction:column;align-items:center;gap:2px;min-width:120px}
.center b{font-family:var(--f-display);font-weight:900;font-size:clamp(44px,9vw,66px);line-height:1;font-variant-numeric:tabular-nums;color:var(--fg);transition:color .15s}
.center small{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
.center.used b{color:#3f5a70}
.center.ok b{color:var(--gem);animation:cpop .35s cubic-bezier(.3,1.7,.5,1)}
.center.bad b{color:var(--mine);animation:cpop .35s cubic-bezier(.3,1.7,.5,1)}
.center.won b{color:var(--gold)}
.center.ok small{color:var(--gem)}.center.bad small{color:var(--mine)}.center.won small{color:var(--gold)}
@keyframes cpop{0%{transform:scale(.8)}100%{transform:scale(1)}}
.valbtn{min-width:220px;border:0;border-radius:14px;padding:15px 20px;font-family:var(--f-display);font-weight:700;font-size:14px;letter-spacing:.06em;text-transform:uppercase;color:#04201b;background:linear-gradient(180deg,#46f3cf,#1fcaa6);box-shadow:0 5px 0 #128a73,0 10px 26px rgba(44,240,194,.22);transition:transform .08s,filter .15s}
.valbtn.rnd{color:#2a1a00;background:linear-gradient(180deg,#ffd76a,#f5b82e);box-shadow:0 5px 0 #b07d10,0 10px 26px rgba(255,200,61,.25)}
.valbtn.go{color:#e9efff;background:linear-gradient(180deg,#3b78f0,#2457c2);box-shadow:0 5px 0 #173c8a,0 10px 26px rgba(24,165,255,.25)}
.valbtn small{display:block;font-family:var(--f-mono);font-size:11px;letter-spacing:0;opacity:.8;margin-top:2px}
.valbtn:hover:not(:disabled){filter:brightness(1.08)}
.valbtn:active:not(:disabled){transform:translateY(3px)}
.valbtn:disabled{filter:grayscale(.7) brightness(.6);cursor:default}
.tried{display:flex;flex-wrap:wrap;gap:5px;justify-content:center;min-height:26px}
.tried span{font-family:var(--f-mono);font-size:12px;font-weight:700;padding:4px 8px;border-radius:8px;background:rgba(44,240,194,.1);color:var(--gem);animation:slidein .2s ease-out}
.tried span.bad{background:rgba(255,61,110,.12);color:var(--mine)}
.nogl{position:absolute;inset:0;display:grid;place-items:center;color:var(--mute);font-weight:700;text-align:center;padding:20px}
@media (max-width:520px){.nopanel{flex-direction:column;gap:10px}}
@@PARAMS
      <div class="field">
        <span class="lbl">Numéros d’alarme cachés</span>
        <div class="risk" id="risk"><button class="mini" type="button" aria-label="Moins">−</button><input type="range" aria-label="Numéros d'alarme"><button class="mini" type="button" aria-label="Plus">+</button><output></output></div>
        <p class="hint">Le cadran va de 0 à 99. Tourne-le, arrête-toi sur un numéro et valide. Un numéro d’alarme et tout est perdu.</p>
      </div>
      <button class="subbtn" id="rand" type="button">Numéro au hasard</button>
@@AUTO
        <span class="lbl">Vitesse</span>
        <div class="seg" id="aspd" role="group" aria-label="Vitesse de l'auto"><button type="button" data-v="1">×1</button><button type="button" data-v="2">×2</button><button type="button" data-v="5">×5</button></div>
        <label for="an">Encaisser après</label>
        <div class="inp"><input id="an" type="number" min="1" max="99" step="1" value="3" inputmode="numeric"><i>numéros</i></div>
@@STAGE
      <div class="potbar">
        <div><small>Numéros validés</small><b id="sk">0</b></div>
        <div><small>Multiplicateur</small><b id="smul">1,00×</b></div>
        <div><small>Numéro suivant</small><b id="snext">—</b></div>
      </div>
      <p class="status" id="status" aria-live="polite">Mise, puis tourne le cadran et valide des numéros.</p>
      <div class="sfwrap">
        <div class="scene" id="dial" aria-label="Coffre-fort en 3D : glisse pour tourner le cadran" role="img"><canvas id="dcv"></canvas></div>
        <div class="gpop" id="spop" aria-live="polite"><b></b><span></span><small></small></div>
      </div>
      <div class="nopanel">
        <div class="center" id="center"><b id="num">00</b><small id="dsub">Tourne le cadran</small></div>
        <button class="valbtn" id="valid" type="button">Miser</button>
      </div>
      <div class="tried" id="tried" aria-label="Numéros essayés"></div>
@@JS
/* ================= COFFRE-FORT 3D =================
   a numéros d'alarme cachés parmi 0–99, tirés au hasard. Tourner le cadran ne donne aucun indice :
   chaque numéro non essayé a la même chance d'être une alarme. Multiplicateur : 0,99 × produit des cotes justes. */
const NN=100, STEP=Math.PI*2/NN;
const V={ a:(store.a>=1&&store.a<=60)?store.a:10, state:'idle', alarms:new Set(), used:new Set(), k:0, bet:0, lost:false, locked:false, busy:false, resolve:null,
  th:0, vel:0, drag:null, lastNum:0, reveal:false, spin:false, justOk:-1, spd:[1,2,5].includes(store.aspd)?store.aspd:2, lastTk:0 };
const dial=$('#dial'), center=$('#center');
function status(h){ $('#status').innerHTML=h; }
const total=()=>V.lost?0:mineMult(NN,V.a,V.k);
const risk=riskCtl('#risk',1,60,V.a,v=>{ V.a=v; paint(); save(); });
const cur=()=>{ let n=Math.round(-V.th/STEP)%NN; return n<0?n+NN:n; };
const pad=n=>String(n).padStart(2,'0');

/* ---------- scène 3D (formes simples, matières lisses) ---------- */
const T3={ ok:false };
(function setup(){
  if(!window.THREE){ dial.insertAdjacentHTML('beforeend','<div class="nogl">Impossible de charger la 3D.</div>'); return; }
  let renderer; try{ renderer=new THREE.WebGLRenderer({canvas:$('#dcv'),antialias:true,alpha:true}); }catch(e){ dial.insertAdjacentHTML('beforeend','<div class="nogl">La 3D n’est pas disponible sur cet appareil.</div>'); return; }
  renderer.setPixelRatio(Math.min(2,window.devicePixelRatio||1));
  const scene=new THREE.Scene(), cam=new THREE.PerspectiveCamera(32,1,.1,100); cam.position.set(0,.4,15.5); cam.lookAt(0,0,0);
  scene.add(new THREE.HemisphereLight(0xcfe0ff,0x0a1124,.7));
  const key=new THREE.DirectionalLight(0xffffff,.75); key.position.set(4,6,8); scene.add(key);
  const rim=new THREE.PointLight(0x2cf0c2,.35,30); rim.position.set(-6,-3,6); scene.add(rim);
  const alarmL=new THREE.PointLight(0xff3d6e,0,25); alarmL.position.set(0,0,5); scene.add(alarmL);
  const goldL=new THREE.PointLight(0xffc83d,0,14); goldL.position.set(0,0,.6); scene.add(goldL);
  const mat=(c,r=.55,m=.15)=>new THREE.MeshStandardMaterial({color:c,roughness:r,metalness:m});
  /* corps du coffre + intérieur */
  const body=new THREE.Mesh(new THREE.BoxGeometry(7.2,7.2,3),mat(0x121b36,.6,.1)); body.position.z=-1.6; scene.add(body);
  const hole=new THREE.Mesh(new THREE.BoxGeometry(6.2,6.2,.4),mat(0x05070f,.9,0)); hole.position.z=-.36; scene.add(hole);
  const gold=new THREE.Group(); const gm=new THREE.MeshStandardMaterial({color:0xffc83d,roughness:.3,metalness:.6,emissive:0x5a3a00,emissiveIntensity:.4});
  [[-1.3,-1.6],[0,-1.6],[1.3,-1.6],[-.65,-.95],[.65,-.95],[0,-.3]].forEach(([x,y])=>{ const b=new THREE.Mesh(new THREE.BoxGeometry(1.15,.55,.9),gm); b.position.set(x,y,-.75); gold.add(b); });
  scene.add(gold);
  /* porte sur charnière (bord gauche) */
  const hinge=new THREE.Group(); hinge.position.set(-3.1,0,.18); scene.add(hinge);
  const door=new THREE.Group(); door.position.x=3.1; hinge.add(door);
  door.add(new THREE.Mesh(new THREE.BoxGeometry(6.2,6.2,.5),mat(0x22364a,.5,.15)));
  const inset=new THREE.Mesh(new THREE.BoxGeometry(5.4,5.4,.06),mat(0x1b2c3d,.55,.1)); inset.position.z=.27; door.add(inset);
  const boltM=mat(0x8d9bc6,.35,.5);
  [[-2.55,2.55],[2.55,2.55],[-2.55,-2.55],[2.55,-2.55]].forEach(([x,y])=>{ const b=new THREE.Mesh(new THREE.CylinderGeometry(.16,.16,.12,24),boltM); b.rotation.x=Math.PI/2; b.position.set(x,y,.3); door.add(b); });
  const handle=new THREE.Mesh(new THREE.CylinderGeometry(.16,.16,1.9,24),mat(0xc9d6ff,.3,.55)); handle.position.set(2.5,0,.55); door.add(handle);
  [.8,-.8].forEach(y=>{ const s=new THREE.Mesh(new THREE.CylinderGeometry(.09,.09,.35,16),mat(0xc9d6ff,.3,.55)); s.rotation.x=Math.PI/2; s.position.set(2.5,y,.4); door.add(s); });
  /* cadran : texture dessinée (crans, chiffres, pastilles) */
  const tc=document.createElement('canvas'); tc.width=tc.height=1024; const tx=tc.getContext('2d');
  const tex=new THREE.CanvasTexture(tc); tex.anisotropy=4;
  function paintTex(){
    const c=512, R=500, band=R*.26, rIn=R-band;
    tx.clearRect(0,0,1024,1024);
    tx.fillStyle='#3b5468'; tx.beginPath(); tx.arc(c,c,R,0,Math.PI*2); tx.fill();
    tx.fillStyle='#16243a'; tx.beginPath(); tx.arc(c,c,rIn,0,Math.PI*2); tx.fill();
    tx.save(); tx.translate(c,c);
    for(let n=0;n<NN;n++){
      const a=n*STEP-Math.PI/2, big=n%10===0, mid=n%5===0, r1=R-band*.14, r2=R-band*(big?.55:mid?.42:.3);
      tx.strokeStyle=big?'rgba(233,239,255,.95)':'rgba(233,239,255,.45)'; tx.lineWidth=big?9:4.5; tx.lineCap='round';
      tx.beginPath(); tx.moveTo(Math.cos(a)*r1,Math.sin(a)*r1); tx.lineTo(Math.cos(a)*r2,Math.sin(a)*r2); tx.stroke();
      if(big){ tx.save(); tx.rotate(n*STEP); tx.fillStyle='#c9d6ff'; tx.font='700 52px "JetBrains Mono",monospace'; tx.textAlign='center'; tx.textBaseline='middle'; tx.fillText(String(n),0,-rIn+52); tx.restore(); }
      const used=V.used.has(n), al=V.reveal&&V.alarms.has(n);
      if(used||al){ const rr=rIn-120; tx.fillStyle=al?(used?'#ff3d6e':'rgba(255,61,110,.7)'):'#2cf0c2'; tx.beginPath(); tx.arc(Math.cos(a)*rr,Math.sin(a)*rr,14,0,Math.PI*2); tx.fill(); }
    }
    tx.restore(); tex.needsUpdate=true;
  }
  const dialG=new THREE.Group(); dialG.position.set(-.2,0,.55); door.add(dialG);
  const dialSpin=new THREE.Group(); dialG.add(dialSpin);
  const disc=new THREE.Mesh(new THREE.CylinderGeometry(2.1,2.1,.36,96),[mat(0x1f3140,.5,.2),new THREE.MeshStandardMaterial({map:tex,roughness:.5,metalness:.1}),mat(0x1f3140)]);
  disc.rotation.x=Math.PI/2; dialSpin.add(disc);
  const knob=new THREE.Mesh(new THREE.CylinderGeometry(.62,.7,.45,64),new THREE.MeshStandardMaterial({color:0x0f1a30,roughness:.4,metalness:.3,emissive:0x2cf0c2,emissiveIntensity:0})); knob.rotation.x=Math.PI/2; knob.position.z=.35; dialSpin.add(knob);
  const grip=new THREE.Mesh(new THREE.BoxGeometry(.18,1.0,.12),mat(0x3b5468,.5,.2)); grip.position.z=.62; dialSpin.add(grip);
  const ptr=new THREE.Mesh(new THREE.ConeGeometry(.22,.42,3),new THREE.MeshStandardMaterial({color:0x2cf0c2,emissive:0x2cf0c2,emissiveIntensity:.6,roughness:.4})); ptr.rotation.z=Math.PI; ptr.position.set(0,2.42,.35); dialG.add(ptr);
  Object.assign(T3,{ok:true,renderer,scene,cam,hinge,door,dialG,dialSpin,knob,gold,goldL,alarmL,paintTex,open:0,openT:0,shake:0,pulse:0,body});
  paintTex();
})();
let lastFrame=performance.now(), mx=0, my=0;
dial.addEventListener('pointermove',e=>{ const r=dial.getBoundingClientRect(); mx=(e.clientX-r.left)/r.width-.5; my=(e.clientY-r.top)/r.height-.5; });
function size(){ if(!T3.ok) return; const w=dial.clientWidth, h=dial.clientHeight; T3.renderer.setSize(w,h,false); T3.cam.aspect=w/h; T3.cam.updateProjectionMatrix(); }
function render3d(t){
  const dt=Math.min(.05,(t-lastFrame)/1000); lastFrame=t;
  if(T3.ok){
    T3.dialSpin.rotation.z=-V.th;
    /* porte : ouverture à l'encaissement */
    const target=T3.open; T3.hinge.rotation.y+=(target-T3.hinge.rotation.y)*Math.min(1,dt*4.5);
    T3.goldL.intensity+=((target<0?1.6:0)-T3.goldL.intensity)*Math.min(1,dt*3);
    T3.alarmL.intensity*=Math.exp(-dt*2.2);
    T3.shake*=Math.exp(-dt*8); const sx=(Math.random()-.5)*T3.shake*.25, sy=(Math.random()-.5)*T3.shake*.25;
    T3.pulse*=Math.exp(-dt*5); T3.knob.material.emissiveIntensity=T3.pulse*.9;
    /* légère parallaxe à la souris */
    T3.cam.position.x+=((mx*1.6+sx)-T3.cam.position.x)*Math.min(1,dt*3); T3.cam.position.y+=((.4-my*1.2+sy)-T3.cam.position.y)*Math.min(1,dt*3); T3.cam.lookAt(0,0,0);
    T3.renderer.render(T3.scene,T3.cam);
  }
  requestAnimationFrame(render3d);
}
function draw(){ if(T3.ok) T3.paintTex(); }
/* centre du cadran à l'écran (pour tourner au doigt) */
function dialCenter(){ const r=dial.getBoundingClientRect(); if(!T3.ok) return [r.left+r.width/2,r.top+r.height/2]; const v=new THREE.Vector3(); T3.dialG.getWorldPosition(v); v.project(T3.cam); return [r.left+(v.x+1)/2*r.width, r.top+(1-v.y)/2*r.height]; }
function onTurn(){ const n=cur(); if(n!==V.lastNum){ V.lastNum=n; const t=performance.now(); if(!V.spin&&t-V.lastTk>28){ V.lastTk=t; sfx.tone(n%10===0?230:190,.03,{v:.035,a:.002,lp:650}); } if(n!==V.justOk) V.justOk=-1; } numUI(); }
function numUI(){
  const n=cur(), btn=$('#valid');
  $('#num').textContent=pad(n);
  const used=V.state==='playing'&&V.used.has(n);
  center.classList.toggle('used',used&&V.justOk!==n);
  if(V.state==='playing'&&!center.classList.contains('bad')) $('#dsub').textContent=V.justOk===n?'Bon numéro !':used?'Déjà validé':'Valider ?';
  if(V.state!=='playing'){ btn.className='valbtn'; btn.textContent=S.balance<0.1?'Recharger 1 000':'Miser'; btn.disabled=auto||V.busy; }
  else if(V.busy){ btn.className='valbtn go'; btn.textContent='…'; btn.disabled=true; }
  else if(used||V.spin){ btn.className='valbtn rnd'; btn.innerHTML='Au hasard'+'<small>tourner vers un numéro libre</small>'; btn.disabled=auto||V.spin; }
  else { btn.className='valbtn go'; btn.innerHTML='Valider le '+pad(n)+'<small>→ '+labX(mineMult(NN,V.a,V.k+1))+'</small>'; btn.disabled=auto; }
}
/* rotation : glisser, molette, flèches, élan */
function ang(e){ const [x,y]=dialCenter(); return Math.atan2(e.clientY-y,e.clientX-x); }
dial.addEventListener('pointerdown',e=>{ if(V.busy||auto) return; sfx.init(); dial.setPointerCapture(e.pointerId); V.drag={a:ang(e),t:performance.now()}; V.vel=0; dial.classList.add('drag'); });
dial.addEventListener('pointermove',e=>{ if(!V.drag) return; const a=ang(e); let d=a-V.drag.a; if(d>Math.PI) d-=Math.PI*2; if(d<-Math.PI) d+=Math.PI*2; const now=performance.now(); V.vel=d/Math.max(1,now-V.drag.t)*16; V.drag={a,t:now}; V.th+=d; onTurn(); });
const endDrag=()=>{ if(!V.drag) return; V.drag=null; dial.classList.remove('drag'); coast(); };
dial.addEventListener('pointerup',endDrag); dial.addEventListener('pointercancel',endDrag);
dial.addEventListener('wheel',e=>{ if(V.busy||auto) return; e.preventDefault(); turnTo(cur()+(e.deltaY>0?1:-1)); },{passive:false});
function coast(){ const step=()=>{ if(V.drag) return; if(Math.abs(V.vel)>.002){ V.th+=V.vel; V.vel*=.93; onTurn(); requestAnimationFrame(step); } else turnTo(cur(),true); }; requestAnimationFrame(step); }
function turnTo(n,quiet){ const target=-n*STEP; let from=V.th, d=target-from; d=((d%(Math.PI*2))+Math.PI*3)%(Math.PI*2)-Math.PI; const t0=performance.now(), dur=quiet?140:Math.min(500,120+Math.abs(d)*120);
  const st=t=>{ const k=Math.min(1,(t-t0)/dur), e=1-Math.pow(1-k,3); V.th=from+d*e; onTurn(); if(k<1) requestAnimationFrame(st); }; requestAnimationFrame(st); }
document.addEventListener('keydown',e=>{ if(e.target&&e.target.tagName==='INPUT') return; if(V.busy||auto) return;
  if(e.key==='ArrowRight'||e.key==='ArrowLeft'){ e.preventDefault(); turnTo(cur()+(e.key==='ArrowRight'?-1:1)*(e.shiftKey?10:1)); }
  else if(e.key==='Enter'&&V.state==='playing'){ e.preventDefault(); if(V.used.has(cur())) randomNum(); else validate(); }
  else if(e.key==='r'||e.key==='R') randomNum(); });
function paint(){ $('#sk').textContent=V.k; $('#smul').textContent=labX(total()); $('#snext').textContent=V.state==='playing'&&NN-V.k>V.a?labX(mineMult(NN,V.a,V.k+1)):'—'; dial.classList.toggle('off',V.busy||auto); numUI(); }
function reset(){ V.used=new Set(); V.k=0; V.lost=false; V.reveal=false; V.justOk=-1; center.className='center'; $('#tried').innerHTML=''; $('#spop').classList.remove('show'); if(T3.ok) T3.open=0; draw(); }
function start(){
  if(V.state==='playing') return null;
  const b=takeBet(); if(!b){ refresh(); return null; }
  reset(); V.bet=b; V.alarms=new Set(); while(V.alarms.size<V.a) V.alarms.add(Math.floor(rnd()*NN));
  V.state='playing'; lock(true); applyLock(); paint(); refresh(); sfx.whoosh(); status('Tourne le cadran, puis valide un numéro.');
  return new Promise(r=>V.resolve=r);
}
async function validate(){
  const n=cur();
  if(V.state!=='playing'||V.busy||V.used.has(n)) return;
  V.busy=true; center.classList.remove('ok','bad'); paint(); refresh();
  sfx.noise(.22,{v:.07,type:'bandpass',f0:300,f1:900,q:1.2,a:.08}); await wait(Math.round((auto?120:200)/(auto?V.spd:1)));
  V.used.add(n); V.busy=false;
  const chip=document.createElement('span'); chip.textContent=pad(n); $('#tried').prepend(chip);
  if(V.alarms.has(n)){ chip.className='bad'; center.classList.add('bad'); $('#dsub').textContent='Alarme !'; lose(); return; }
  V.k++; V.justOk=n; center.classList.add('ok'); if(T3.ok) T3.pulse=1;
  sfx.thump(Math.min(11,Math.floor(V.k*.8))); vib(10);
  draw(); bump($('#smul')); paint(); refresh();
  if(NN-V.k===V.a){ setTimeout(()=>cashout('Tous les bons numéros trouvés !'),300); return; }
  status(pad(n)+' est bon · '+labX(total())+' · gain '+fmt(V.bet*total()));
  setTimeout(()=>{ if(V.state==='playing'&&cur()!==n) center.classList.remove('ok'); },650);
}
function lose(){ V.lost=true; V.reveal=true; draw(); if(T3.ok){ T3.alarmL.intensity=3; T3.shake=1.4; } loseFx(); settle(V.bet,0); hist('0,00×',false); status('Alarme ! Le numéro '+pad(cur())+' était piégé. −'+fmt(V.bet)); finish(); }
function cashout(sub){
  if(V.state!=='playing'||V.k<1||V.busy) return;
  const m=total(), pay=settle(V.bet,m); hist(labX(m),true); V.reveal=true; center.className='center won'; $('#dsub').textContent='Coffre ouvert'; draw();
  if(T3.ok) T3.open=-1.75; sfx.tone(80,.7,{v:.25,slide:.8,lp:260});
  showPop('#spop',m,pay,sub||V.k+' numéro'+(V.k>1?'s':'')); winFx(m);
  status('Coffre ouvert ! '+labX(m)+' · <b'+(m>=5?' class="g"':'')+'>+'+fmt(pay)+'</b>'); finish();
}
function finish(){ V.state='over'; paint(); lock(auto); applyLock(); refresh(); const r=V.resolve; V.resolve=null; r&&r(); }
function randomNum(){
  if(V.state!=='playing'||V.busy||V.spin) return;
  const c=[...Array(NN).keys()].filter(n=>!V.used.has(n)), n=c[Math.floor(rnd()*c.length)];
  V.spin=true; center.classList.remove('ok'); sfx.noise(.25,{v:.06,type:'bandpass',f0:500,f1:1400,q:1,a:.05}); numUI();
  const target=-n*STEP, from=V.th; let d=target-from; d=((d%(Math.PI*2))+Math.PI*2)%(Math.PI*2); d+=Math.PI*2*(d<Math.PI?1:0);
  const t0=performance.now(), dur=auto?Math.round(420/V.spd):420;
  const st=t=>{ const k=Math.min(1,(t-t0)/dur), e=1-Math.pow(1-k,3); V.th=from+d*e; onTurn(); if(k<1) requestAnimationFrame(st); else { V.th=target; V.spin=false; onTurn(); sfx.tone(200,.05,{v:.06,lp:700}); } };
  requestAnimationFrame(st);
}
/* le gros bouton : « Miser » avant la partie, « Valider » ou « Au hasard » pendant */
$('#valid').addEventListener('click',()=>{ if(V.state!=='playing'){ mainAction(); return; } if(V.used.has(cur())) randomNum(); else validate(); });
$('#rand').addEventListener('click',randomNum);
async function autoRound(){
  const pr=start(); if(!pr) return;
  const N=Math.max(1,parseInt($('#an').value)||1);
  (async()=>{ while(V.state==='playing'){ await wait(Math.round(200/V.spd)); if(V.state!=='playing'||V.busy||V.spin) continue; if(V.k>=N){ cashout(); break; }
    randomNum(); await wait(Math.round(460/V.spd)+20); await validate(); } })();
  return pr;
}
function applyLock(){ risk.disable(V.locked||V.state==='playing'); $('#an').disabled=V.locked; $('#rand').disabled=V.state!=='playing'||auto; }
if(window.ResizeObserver) new ResizeObserver(size).observe(dial); else window.addEventListener('resize',size);
const G={
  main(){ if(V.state==='playing'){ cashout(); return; } start(); },
  cta(){ if(V.state==='playing') return V.busy?{label:'Vérification…',disabled:true}:V.k<1?{label:'Valide un numéro',disabled:true}:{label:'Encaisser '+fmt(V.bet*total()),cls:'cash'}; return {label:'Miser'}; },
  busy:()=>V.state==='playing',
  autoReady:()=>true,
  autoStep(){ return autoRound()||Promise.resolve(); },
  autoGap:()=>Math.round(900/V.spd),
  lock(l){ V.locked=l; applyLock(); paint(); },
  saveState:()=>({a:V.a,aspd:V.spd}),
  status
};
function spdSync(){ document.querySelectorAll('#aspd button').forEach(b=>b.setAttribute('aria-pressed',String(+b.dataset.v===V.spd))); }
$('#aspd').addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b) return; V.spd=+b.dataset.v; spdSync(); sfx.ui(); save(); });
spdSync(); size(); paint(); applyLock(); kitInit(); requestAnimationFrame(render3d);
if(document.fonts&&document.fonts.ready) document.fonts.ready.then(draw);
