@@META
title=Neon Plinko
icon=<svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="6" r="3" fill="#ffc83d"/><g fill="#2cf0c2"><circle cx="11" cy="14" r="2"/><circle cx="21" cy="14" r="2"/><circle cx="6" cy="21" r="2"/><circle cx="16" cy="21" r="2"/><circle cx="26" cy="21" r="2"/></g><rect x="3" y="26" width="26" height="4" rx="2" fill="#18a5ff"/></svg>
a=Neon
b=Plinko
key=neon-plinko-v1
keyhint=lâcher une bille (maintiens pour en lâcher en rafale)
@@CSS
.pwrap{width:min(100%,680px);margin:0 auto;position:relative}
.pwrap canvas{display:block;width:100%;touch-action:manipulation}
.plast{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
.plast span{font-family:var(--f-mono);font-weight:700;font-size:13px;padding:6px 10px;border-radius:10px;background:var(--panel2);border:1px solid var(--line);color:var(--mute)}
@@PARAMS
      <div class="field">
        <span class="lbl">Risque</span>
        <div class="seg" id="risk" role="group" aria-label="Risque"><button type="button" data-v="low">Faible</button><button type="button" data-v="med">Moyen</button><button type="button" data-v="high">Élevé</button></div>
      </div>
      <div class="field">
        <span class="lbl">Rangées</span>
        <div class="seg" id="rows" role="group" aria-label="Nombre de rangées"><button type="button" data-v="8">8</button><button type="button" data-v="12">12</button><button type="button" data-v="16">16</button></div>
      </div>
@@AUTO
@@STAGE
      <p class="status" id="status" aria-live="polite">Choisis le risque et les rangées, puis lâche des billes.</p>
      <div class="pwrap" id="pwrap"><canvas id="pcv" aria-label="Plateau de Plinko" role="img"></canvas></div>
@@JS
/* ================= PLINKO ================= */
const TABLE={
  8:{low:[5.6,2.1,1.1,1,.5,1,1.1,2.1,5.6],med:[13,3,1.3,.7,.4,.7,1.3,3,13],high:[29,4,1.5,.3,.2,.3,1.5,4,29]},
  12:{low:[10,3,1.6,1.4,1.1,1,.5,1,1.1,1.4,1.6,3,10],med:[33,11,4,2,1.1,.6,.3,.6,1.1,2,4,11,33],high:[170,24,8.1,2,.7,.2,.2,.2,.7,2,8.1,24,170]},
  16:{low:[16,9,2,1.4,1.4,1.2,1.1,1,.5,1,1.1,1.2,1.4,1.4,2,9,16],med:[110,41,10,5,3,1.5,1,.5,.3,.5,1,1.5,3,5,10,41,110],high:[1000,130,26,9,4,2,.2,.2,.2,.2,.2,2,4,9,26,130,1000]}
};
const P={ rows:[8,12,16].includes(store.rows)?store.rows:16, risk:['low','med','high'].includes(store.risk)?store.risk:'med', kitLock:false };
const cv=$('#pcv'), g2=cv.getContext('2d'), wrap=$('#pwrap');
let W=0,H=0,dpr=1,geo=null,balls=[],glow=[],bounce=null,hit=null,raf=0,last=0,inflight=0;
function status(h){ $('#status').innerHTML=h; }
const mults=()=>TABLE[P.rows][P.risk];
function layout(){
  W=Math.max(260,wrap.clientWidth); const R=P.rows, s=W/(R+3), dy=s*.9, y0=s*1.25;
  const pr=Math.max(2.4,s*.1), br=Math.max(4.5,s*.23), by=y0+(R-1)*dy+s*.62, bh=Math.max(20,s*.74);
  H=Math.round(by+bh+s*.35); dpr=Math.min(2,window.devicePixelRatio||1);
  cv.width=Math.round(W*dpr); cv.height=Math.round(H*dpr); cv.style.height=H+'px';
  geo={R,s,dy,y0,pr,br,by,bh,cx:W/2};
  glow=[]; for(let r=0;r<R;r++) glow.push(new Float32Array(r+3));
  bounce=new Float32Array(R+1); hit=new Float32Array(R+1);
  kick();
}
const pegX=(r,j)=>geo.cx+(j-(r+2)/2)*geo.s, pegY=r=>geo.y0+r*geo.dy;
const ballX=(r,k)=>geo.cx+(k-r/2)*geo.s, contactY=r=>pegY(r)-geo.pr-geo.br*.92;
const bucketX=k=>geo.cx+(k-geo.R/2)*geo.s;
function bucketColor(k,l){ const R=geo.R, d=Math.abs(k-R/2)/(R/2), h=50-d*62; return 'hsl('+h.toFixed(0)+' 95% '+(l||56)+'%)'; }
function label(m){ return (m>=100?m.toFixed(0):String(m)).replace('.',',')+'×'; }
function rr(x,y,w,h,r){ g2.beginPath(); g2.moveTo(x+r,y); g2.arcTo(x+w,y,x+w,y+h,r); g2.arcTo(x+w,y+h,x,y+h,r); g2.arcTo(x,y+h,x,y,r); g2.arcTo(x,y,x+w,y,r); g2.closePath(); }

/* lâcher une bille */
function drop(){
  if(!geo) layout();
  const b=takeBet(); if(!b){ refresh(); return false; }
  const path=[]; for(let i=0;i<geo.R;i++) path.push(rnd()<.5?0:1);
  balls.push({path,k:0,seg:-1,t:0,bet:b,trail:[],x:geo.cx,y:0,wob:(rnd()-.5)*.6});
  inflight++; applyLock(); kick(); return true;
}
function land(ball){
  const k=ball.k, m=mults()[k]; bounce[k]=1; hit[k]=1;
  const pay=settle(ball.bet,m);
  if(m<1) sfx.dull(.55);
  else if(m<2) sfx.thump(1,.85);
  else if(m<5) sfx.thump(4);
  else if(m<20){ sfx.thump(7); sfx.win(1); }
  else if(m<100){ sfx.thump(9); sfx.win(2); flash('gold'); vib(20); }
  else { sfx.thump(11); sfx.win(3); flash('gold'); shake($('#stage')); vib([30,30,60]); }
  hist(label(m),m>=1);
  status((m>=1?'Bille en '+label(m)+' · <b'+(m>=10?' class="g"':'')+'>+'+fmt(pay)+'</b>':'Bille en '+label(m)+' · '+fmt(pay)+' récupérés'));
  inflight--; applyLock();
}
function update(dt){
  const D=.112, D0=.24;
  for(let i=balls.length-1;i>=0;i--){
    const b=balls[i]; b.t+=dt;
    for(;;){
      const dur=b.seg<0?D0:D; if(b.t<dur) break; b.t-=dur;
      if(b.seg>=0) b.k+=b.path[b.seg];
      b.seg++;
      if(b.seg>=geo.R){ land(b); balls.splice(i,1); break; }
      /* contact avec une cheville de la rangée b.seg */
      const j=b.k+1; if(glow[b.seg]&&j<glow[b.seg].length) glow[b.seg][j]=1;
      sfx.tick(250+b.seg*9,.028);
    }
    if(balls[i]!==b) continue;
    const dur=b.seg<0?D0:D, u=Math.min(1,b.t/dur);
    let x,y;
    if(b.seg<0){ x=geo.cx+b.wob*(1-u)*geo.s*.15; const ys=geo.y0-geo.dy*1.15; y=ys+(contactY(0)-ys)*u*u; }
    else{
      const r=b.seg, x0=ballX(r,b.k), x1=ballX(r+1,b.k+b.path[r]), y0=contactY(r);
      const y1=r+1<geo.R?contactY(r+1):geo.by-geo.br*.6;
      x=x0+(x1-x0)*u; y=y0+(y1-y0)*u*u-geo.dy*.34*4*u*(1-u);
    }
    b.x=x; b.y=y; b.trail.push(x,y); if(b.trail.length>14) b.trail.splice(0,2);
  }
  const f=Math.exp(-dt*5.5), fb=Math.exp(-dt*7);
  for(const row of glow) for(let j=0;j<row.length;j++) row[j]*=f;
  for(let k=0;k<bounce.length;k++){ bounce[k]*=fb; hit[k]*=Math.exp(-dt*3); }
}
function draw(){
  g2.setTransform(dpr,0,0,dpr,0,0); g2.clearRect(0,0,W,H);
  const {R,s,pr,br,by,bh}=geo;
  /* chevilles */
  for(let r=0;r<R;r++){ const y=pegY(r);
    for(let j=0;j<r+3;j++){ const x=pegX(r,j), gl=glow[r][j];
      if(gl>.02){ g2.fillStyle='rgba(44,240,194,'+(gl*.28).toFixed(3)+')'; g2.beginPath(); g2.arc(x,y,pr*(2.2+gl*2.2),0,6.2832); g2.fill(); }
      g2.fillStyle=gl>.02?'rgb('+Math.round(201+(44-201)*gl)+','+Math.round(214+(240-214)*gl)+','+Math.round(255+(194-255)*gl)+')':'#c9d6ff';
      g2.beginPath(); g2.arc(x,y,pr*(1+gl*.45),0,6.2832); g2.fill(); } }
  /* cases */
  const ms=mults(), bw=s*.88, fs=Math.max(8,Math.min(15,s*.3));
  g2.font='700 '+fs+'px "JetBrains Mono",ui-monospace,monospace'; g2.textAlign='center'; g2.textBaseline='middle';
  for(let k=0;k<=R;k++){ const x=bucketX(k)-bw/2, off=Math.sin(Math.min(1,bounce[k])*Math.PI)*0+bounce[k]*s*.2, y=by+off;
    g2.fillStyle=bucketColor(k,32); rr(x,y+4,bw,bh,Math.min(8,bw*.2)); g2.fill();
    g2.fillStyle=bucketColor(k,56+hit[k]*14); rr(x,y,bw,bh,Math.min(8,bw*.2)); g2.fill();
    if(hit[k]>.05){ g2.save(); g2.globalAlpha=hit[k]*.5; g2.shadowColor=bucketColor(k,60); g2.shadowBlur=18; rr(x,y,bw,bh,Math.min(8,bw*.2)); g2.fill(); g2.restore(); }
    let t=label(ms[k]); g2.fillStyle='#1a0f00'; let f=fs; while(f>7&&g2.measureText(t).width>bw-4){ f-=.5; g2.font='700 '+f+'px "JetBrains Mono",ui-monospace,monospace'; }
    g2.fillText(t,x+bw/2,y+bh/2+.5); if(f!==fs) g2.font='700 '+fs+'px "JetBrains Mono",ui-monospace,monospace'; }
  /* billes */
  for(const b of balls){
    for(let i=0;i<b.trail.length;i+=2){ const a=(i/b.trail.length)*.22; g2.fillStyle='rgba(255,200,61,'+a.toFixed(3)+')'; g2.beginPath(); g2.arc(b.trail[i],b.trail[i+1],br*(.45+i/b.trail.length*.4),0,6.2832); g2.fill(); }
    const gr=g2.createRadialGradient(b.x-br*.35,b.y-br*.35,br*.15,b.x,b.y,br);
    gr.addColorStop(0,'#fff6d6'); gr.addColorStop(.55,'#ffd25e'); gr.addColorStop(1,'#f0a41c');
    g2.save(); g2.shadowColor='rgba(255,200,61,.75)'; g2.shadowBlur=12; g2.fillStyle=gr; g2.beginPath(); g2.arc(b.x,b.y,br,0,6.2832); g2.fill(); g2.restore();
  }
}
function active(){ if(balls.length) return true; for(const row of glow) for(const v of row) if(v>.02) return true; for(const v of bounce) if(v>.01) return true; for(const v of hit) if(v>.02) return true; return false; }
function frame(t){ const dt=Math.min(.05,(t-last)/1000||0); last=t; update(dt); draw(); if(active()) raf=requestAnimationFrame(frame); else raf=0; }
function kick(){ if(!geo) return; if(!raf){ last=performance.now(); raf=requestAnimationFrame(frame); } else draw(); }

/* réglages */
function segSync(){ document.querySelectorAll('#risk button').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.v===P.risk))); document.querySelectorAll('#rows button').forEach(b=>b.setAttribute('aria-pressed',String(+b.dataset.v===P.rows))); }
function applyLock(){ const d=P.kitLock||inflight>0; document.querySelectorAll('#risk button,#rows button').forEach(b=>b.disabled=d); }
$('#risk').addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b||b.disabled) return; P.risk=b.dataset.v; segSync(); sfx.ui(); kick(); save(); });
$('#rows').addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b||b.disabled) return; P.rows=+b.dataset.v; segSync(); sfx.ui(); layout(); save(); });
if(window.ResizeObserver) new ResizeObserver(()=>{ if(Math.abs(wrap.clientWidth-W)>1) layout(); }).observe(wrap); else window.addEventListener('resize',layout);

const G={
  repeat:true,
  main(){ drop(); },
  cta(){ return {label:'Miser'}; },
  busy:()=>false,
  pending:()=>inflight>0,
  autoReady:()=>true,
  autoStep(){ drop(); return Promise.resolve(); },
  autoGap:()=>240,
  lock(l){ P.kitLock=l; applyLock(); },
  saveState:()=>({rows:P.rows,risk:P.risk}),
  status
};
segSync(); layout(); kitInit();
if(document.fonts&&document.fonts.ready) document.fonts.ready.then(()=>kick());
