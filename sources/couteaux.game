@@META
title=Neon Couteaux
icon=<svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="13" r="11" fill="#8a5a24" stroke="#2cf0c2" stroke-width="1.6"/><circle cx="16" cy="13" r="5" fill="#5a3812"/><path d="M16 22 L16 31" stroke="#c9d6ff" stroke-width="2.4" stroke-linecap="round"/><path d="M16 26 V31" stroke="#18a5ff" stroke-width="3.4" stroke-linecap="round"/></svg>
a=Neon
b=Couteaux
key=neon-knives-v1
keyhint=miser / encaisser — clic sur la cible ou ↑ : lancer
@@CSS
.kvwrap{position:relative;width:min(100%,520px);margin:0 auto}
.kvwrap canvas{display:block;width:100%;touch-action:manipulation;cursor:crosshair}
.kvwrap canvas.off{cursor:default}
.throwbar{display:flex;justify-content:center}
.throwbtn{min-width:220px;border:0;border-radius:14px;padding:14px 18px;font-family:var(--f-display);font-weight:700;font-size:14px;letter-spacing:.06em;text-transform:uppercase;color:#e9efff;background:linear-gradient(180deg,#2f6be0,#1d4396);box-shadow:0 5px 0 #13306e,0 10px 26px rgba(24,165,255,.25);transition:transform .08s,filter .15s}
.throwbtn:hover:not(:disabled){filter:brightness(1.1)}
.throwbtn:active:not(:disabled){transform:translateY(3px);box-shadow:0 2px 0 #13306e}
.throwbtn:disabled{filter:grayscale(.7) brightness(.6);cursor:default}
@@PARAMS
      <div class="field">
        <span class="lbl">Clous cachés dans la cible</span>
        <div class="risk" id="risk"><button class="mini" type="button" aria-label="Moins">−</button><input type="range" aria-label="Clous cachés"><button class="mini" type="button" aria-label="Plus">+</button><output></output></div>
        <p class="hint">La cible a 24 zones. Lance quand tu veux : ton couteau se plante dans la zone en face. Un clou caché le fait rebondir et tu perds tout.</p>
      </div>
@@AUTO
        <label for="an">Encaisser après</label>
        <div class="inp"><input id="an" type="number" min="1" max="23" step="1" value="3" inputmode="numeric"><i>couteaux</i></div>
@@STAGE
      <div class="potbar">
        <div><small>Couteaux plantés</small><b id="kk">0</b></div>
        <div><small>Multiplicateur</small><b id="kmul">1,00×</b></div>
        <div><small>Prochain couteau</small><b id="knext">—</b></div>
      </div>
      <p class="status" id="status" aria-live="polite">Mise, puis lance tes couteaux dans la cible qui tourne.</p>
      <div class="kvwrap" id="kvwrap">
        <canvas id="kcv" aria-label="Cible en bois qui tourne" role="img"></canvas>
        <div class="gpop" id="kpop" aria-live="polite"><b></b><span></span><small></small></div>
      </div>
      <div class="throwbar"><button class="throwbtn" id="throw" type="button" disabled>Lancer un couteau</button></div>
@@JS
/* ================= COUTEAUX =================
   b clous cachés parmi les 24 zones de la cible, placés au hasard. Le moment du lancer choisit la zone,
   mais aucune zone ne donne d'indice : chaque zone libre a la même chance de cacher un clou.
   Multiplicateur : 0,99 × produit des cotes justes. */
const NZ=24, SEG=Math.PI*2/NZ;
const K={ b:(store.b>=1&&store.b<=20)?store.b:4, state:'idle', nails:new Set(), stuck:[], k:0, bet:0, lost:false, locked:false, resolve:null,
  th:0, w:1.5, flying:null, bounce:null, shake:0, reveal:false, lastT:0, raf:0 };
const cv=$('#kcv'), g2=cv.getContext('2d'), wrapEl=$('#kvwrap');
let W=0,H=0,dpr=1,cx=0,cy=0,R=0;
function status(h){ $('#status').innerHTML=h; }
const total=()=>K.lost?0:mineMult(NZ,K.b,K.k);
const risk=riskCtl('#risk',1,20,K.b,v=>{ K.b=v; paint(); save(); });
function size(){ W=Math.max(260,wrapEl.clientWidth); H=Math.round(W*1.08); dpr=Math.min(2,window.devicePixelRatio||1); cv.width=Math.round(W*dpr); cv.height=Math.round(H*dpr); cv.style.height=H+'px'; R=W*.36; cx=W/2; cy=R+W*.08; }
function paint(){
  $('#kk').textContent=K.k; $('#kmul').textContent=labX(total());
  $('#knext').textContent=K.state==='playing'&&NZ-K.k>K.b?labX(mineMult(NZ,K.b,K.k+1)):'—';
  const can=K.state==='playing'&&!K.flying&&!auto; $('#throw').disabled=!can; cv.classList.toggle('off',!can);
}
const norm=a=>{ a%=Math.PI*2; return a<0?a+Math.PI*2:a; };
function zoneAtImpact(){ return Math.floor(norm(Math.PI/2-K.th)/SEG)%NZ; }
function drawKnife(x,y,ang,alpha,len){
  g2.save(); g2.translate(x,y); g2.rotate(ang); g2.globalAlpha=alpha;
  const L=len||R*.5;
  /* lame (vers l'intérieur de la cible, côté négatif) */
  g2.fillStyle='#dfe7ff'; g2.beginPath(); g2.moveTo(-L*.34,0); g2.lineTo(0,-L*.06); g2.lineTo(0,L*.06); g2.closePath(); g2.fill();
  g2.fillStyle='rgba(255,255,255,.6)'; g2.fillRect(-L*.28,-L*.012,L*.26,L*.012);
  /* garde + manche */
  g2.fillStyle='#ffc83d'; g2.fillRect(0,-L*.085,L*.04,L*.17);
  const gr=g2.createLinearGradient(0,-L*.05,0,L*.05); gr.addColorStop(0,'#2f6be0'); gr.addColorStop(1,'#13306e');
  g2.fillStyle=gr; g2.beginPath(); g2.roundRect?g2.roundRect(L*.04,-L*.05,L*.3,L*.1,L*.03):g2.rect(L*.04,-L*.05,L*.3,L*.1); g2.fill();
  g2.fillStyle='#2cf0c2'; g2.fillRect(L*.16,-L*.05,L*.025,L*.1);
  g2.restore();
}
function draw(t){
  g2.setTransform(dpr,0,0,dpr,0,0); g2.clearRect(0,0,W,H);
  const sx=(rnd()-.5)*K.shake*6, sy=(rnd()-.5)*K.shake*6;
  /* halo néon */
  g2.save(); g2.translate(cx+sx,cy+sy);
  g2.shadowColor='rgba(44,240,194,.45)'; g2.shadowBlur=30; g2.fillStyle='#3a240a'; g2.beginPath(); g2.arc(0,0,R+10,0,Math.PI*2); g2.fill(); g2.shadowBlur=0;
  g2.strokeStyle='rgba(44,240,194,.75)'; g2.lineWidth=3; g2.beginPath(); g2.arc(0,0,R+10,0,Math.PI*2); g2.stroke();
  g2.rotate(K.th);
  for(let i=0;i<NZ;i++){ g2.beginPath(); g2.moveTo(0,0); g2.arc(0,0,R,i*SEG,(i+1)*SEG); g2.closePath(); g2.fillStyle=i%2?'#8a5a24':'#7a4e1e'; g2.fill(); }
  const rings=[[.72,'rgba(0,0,0,.18)'],[.48,'rgba(0,0,0,.2)'],[.24,'rgba(0,0,0,.22)']];
  rings.forEach(([f,c])=>{ g2.strokeStyle=c; g2.lineWidth=2; g2.beginPath(); g2.arc(0,0,R*f,0,Math.PI*2); g2.stroke(); });
  g2.strokeStyle='rgba(0,0,0,.25)'; g2.lineWidth=1.2; for(let i=0;i<NZ;i++){ g2.beginPath(); g2.moveTo(0,0); g2.lineTo(Math.cos(i*SEG)*R,Math.sin(i*SEG)*R); g2.stroke(); }
  g2.fillStyle='#ff3d6e'; g2.beginPath(); g2.arc(0,0,R*.1,0,Math.PI*2); g2.fill(); g2.fillStyle='#ffc83d'; g2.beginPath(); g2.arc(0,0,R*.05,0,Math.PI*2); g2.fill();
  /* clous révélés */
  if(K.reveal) K.nails.forEach(i=>{ const a=(i+.5)*SEG, x=Math.cos(a)*R*.86, y=Math.sin(a)*R*.86; const gr=g2.createRadialGradient(x-2,y-2,1,x,y,R*.07); gr.addColorStop(0,'#ffffff'); gr.addColorStop(.4,'#b8c3e0'); gr.addColorStop(1,'#56607e'); g2.fillStyle=gr; g2.beginPath(); g2.arc(x,y,R*.06,0,Math.PI*2); g2.fill(); g2.strokeStyle='rgba(255,61,110,.8)'; g2.lineWidth=2; g2.stroke(); });
  g2.restore();
  /* couteaux plantés (tournent avec la cible) */
  K.stuck.forEach(i=>{ const a=(i+.5)*SEG+K.th; drawKnife(cx+sx+Math.cos(a)*R*1.0,cy+sy+Math.sin(a)*R*1.0,a,1); });
  /* repère d'impact */
  g2.fillStyle=K.state==='playing'?'rgba(255,200,61,.9)':'rgba(141,155,198,.4)'; g2.beginPath(); g2.moveTo(cx,cy+R+16); g2.lineTo(cx-8,cy+R+28); g2.lineTo(cx+8,cy+R+28); g2.closePath(); g2.fill();
  /* couteau en vol / en attente */
  const baseY=cy+R+W*.3;
  if(K.flying){ const k=Math.min(1,(t-K.flying.t0)/K.flying.d), y=baseY+(cy+R-baseY)*(k*k); drawKnife(cx,y,Math.PI/2,1); }
  else if(K.state==='playing'&&!K.bounce) drawKnife(cx,baseY,Math.PI/2,1);
  if(K.bounce){ const k=Math.min(1,(t-K.bounce.t0)/700); drawKnife(cx+K.bounce.dx*k*W*.35,cy+R+40+(-60*k+260*k*k),Math.PI/2+K.bounce.rot*k*8,1-k*.6); }
}
function frame(t){
  const dt=Math.min(.05,(t-K.lastT)/1000||0); K.lastT=t;
  K.th+=K.w*dt; K.shake*=Math.exp(-dt*12);
  draw(t);
  K.raf=requestAnimationFrame(frame);
}
function reset(){ K.stuck=[]; K.k=0; K.lost=false; K.reveal=false; K.bounce=null; K.flying=null; K.w=1.5; $('#kpop').classList.remove('show'); }
function start(){
  if(K.state==='playing') return null;
  const b=takeBet(); if(!b){ refresh(); return null; }
  reset(); K.bet=b; K.nails=new Set(); while(K.nails.size<K.b) K.nails.add(Math.floor(rnd()*NZ));
  K.state='playing'; lock(true); applyLock(); paint(); refresh(); sfx.whoosh(); status('Lance quand tu veux : clic sur la cible, bouton ou ↑.');
  return new Promise(r=>K.resolve=r);
}
function throwKnife(){
  if(K.state!=='playing'||K.flying) return;
  K.flying={t0:performance.now(),d:130}; paint(); refresh();
  sfx.noise(.1,{v:.12,type:'bandpass',f0:1800,f1:700,q:1.4,a:.01});
  setTimeout(land,130);
}
function land(){
  let z=zoneAtImpact();
  if(K.stuck.includes(z)){ /* zone déjà occupée : le couteau glisse vers la zone libre la plus proche */
    for(let d=1;d<NZ;d++){ const a=(z+d)%NZ, b=(z-d+NZ)%NZ; if(!K.stuck.includes(a)){ z=a; break; } if(!K.stuck.includes(b)){ z=b; break; } } }
  K.flying=null;
  if(K.nails.has(z)){ K.bounce={t0:performance.now(),dx:rnd()<.5?-1:1,rot:rnd()<.5?-1:1}; sfx.tone(880,.12,{type:'triangle',v:.12,slide:.7}); K.shake=1; lose(); return; }
  K.stuck.push(z); K.k++; K.shake=.7; K.w=Math.min(4.2,1.5+K.k*.16);
  sfx.tone(120,.14,{v:.45,slide:.55,lp:420}); sfx.noise(.05,{v:.12,f0:1400,f1:400}); sfx.thump(Math.min(11,Math.floor(K.k*.8)),.8); vib(10);
  bump($('#kmul')); paint(); refresh();
  if(NZ-K.k===K.b){ setTimeout(()=>cashout('Cible complète !'),300); return; }
  status('Planté ! '+labX(total())+' · gain '+fmt(K.bet*total()));
}
function lose(){ K.lost=true; setTimeout(()=>{ K.reveal=true; },250); loseFx(); settle(K.bet,0); hist('0,00×',false); status('Clou caché ! Le couteau rebondit… −'+fmt(K.bet)); finish(); }
function cashout(sub){
  if(K.state!=='playing'||K.k<1||K.flying) return;
  const m=total(), pay=settle(K.bet,m); hist(labX(m),true); K.reveal=true; K.w=.5; showPop('#kpop',m,pay,sub||K.k+' couteau'+(K.k>1?'x':'')+' planté'+(K.k>1?'s':'')); winFx(m);
  status('Encaissé ! '+labX(m)+' · <b'+(m>=5?' class="g"':'')+'>+'+fmt(pay)+'</b>'); finish();
}
function finish(){ K.state='over'; paint(); lock(auto); applyLock(); refresh(); const r=K.resolve; K.resolve=null; r&&r(); }
cv.addEventListener('click',()=>{ if(!auto) throwKnife(); });
$('#throw').addEventListener('click',()=>{ if(!auto) throwKnife(); });
document.addEventListener('keydown',e=>{ if(e.target&&e.target.tagName==='INPUT') return; if(e.key==='ArrowUp'&&!auto){ e.preventDefault(); throwKnife(); } });
async function autoRound(){
  const pr=start(); if(!pr) return;
  const N=Math.max(1,parseInt($('#an').value)||1);
  (async()=>{ while(K.state==='playing'){ await wait(350+rnd()*250); if(K.state!=='playing'||K.flying) continue; if(K.k>=N){ cashout(); break; } throwKnife(); await wait(200); } })();
  return pr;
}
function applyLock(){ risk.disable(K.locked||K.state==='playing'); $('#an').disabled=K.locked; }
if(window.ResizeObserver) new ResizeObserver(size).observe(wrapEl); else window.addEventListener('resize',size);
const G={
  main(){ if(K.state==='playing'){ cashout(); return; } start(); },
  cta(){ if(K.state==='playing') return K.k<1?{label:'Lance un couteau',disabled:true}:{label:'Encaisser '+fmt(K.bet*total()),cls:'cash'}; return {label:'Miser'}; },
  busy:()=>K.state==='playing',
  autoReady:()=>true,
  autoStep(){ return autoRound()||Promise.resolve(); },
  autoGap:()=>900,
  lock(l){ K.locked=l; applyLock(); paint(); },
  saveState:()=>({b:K.b}),
  status
};
size(); paint(); applyLock(); K.lastT=performance.now(); K.raf=requestAnimationFrame(frame); kitInit();
