@@META
title=Neon Tower
icon=<svg viewBox="0 0 32 32" aria-hidden="true"><g fill="#2f4553"><rect x="4" y="24" width="7" height="5" rx="1.5"/><rect x="12.5" y="24" width="7" height="5" rx="1.5"/><rect x="21" y="24" width="7" height="5" rx="1.5"/><rect x="4" y="17" width="7" height="5" rx="1.5"/><rect x="21" y="17" width="7" height="5" rx="1.5"/><rect x="12.5" y="10" width="7" height="5" rx="1.5"/><rect x="21" y="10" width="7" height="5" rx="1.5"/></g><rect x="12.5" y="17" width="7" height="5" rx="1.5" fill="#2cf0c2"/><rect x="4" y="10" width="7" height="5" rx="1.5" fill="#2cf0c2"/><rect x="12.5" y="3" width="7" height="5" rx="1.5" fill="#ffc83d"/></svg>
a=Neon
b=Tower
key=neon-tower-v1
keyhint=miser / encaisser — R : case au hasard
@@CSS
.twrap{position:relative;width:min(100%,520px);margin:0 auto}
.tower{display:flex;flex-direction:column-reverse;gap:clamp(6px,1.2vw,9px)}
.trow{display:grid;grid-template-columns:62px minmax(0,1fr);gap:10px;align-items:center;transition:opacity .25s}
.tlab{font-family:var(--f-mono);font-weight:700;font-size:12px;text-align:right;color:var(--mute);transition:color .2s,transform .2s;font-variant-numeric:tabular-nums}
.trow.done .tlab{color:var(--gem)}
.trow.next .tlab{color:var(--gold);transform:scale(1.08)}
.tcells{display:grid;grid-template-columns:repeat(var(--cols,3),minmax(0,1fr));gap:clamp(6px,1.2vw,9px);padding:5px;border-radius:14px;border:1px solid transparent;transition:border-color .2s,background .2s,box-shadow .2s}
.trow.next .tcells{border-color:rgba(255,200,61,.45);background:rgba(255,200,61,.05);box-shadow:0 0 22px rgba(255,200,61,.12)}
.tc{position:relative;height:clamp(34px,6.2vw,46px);border:0;padding:0;background:transparent;border-radius:10px;touch-action:manipulation}
.tc .f,.tc .b{position:absolute;inset:0;border-radius:10px;display:grid;place-items:center}
.tc .f{background:#2f4553;box-shadow:0 4px 0 #1f3140;transition:background .15s,transform .14s ease-in,opacity .14s}
.trow.live .tc:not(:disabled):hover .f,.tower.pre .tc:not(:disabled):hover .f{background:#557086;transform:translateY(-2px)}
.tc.sel .f{background:#1b8f86;box-shadow:0 4px 0 #11524e,0 0 0 2px rgba(44,240,194,.7),0 0 16px rgba(44,240,194,.35);animation:tsel .26s cubic-bezier(.3,1.6,.5,1)}
@keyframes tsel{0%{transform:scale(.93)}60%{transform:scale(1.05)}100%{transform:scale(1)}}
.tc .b{transform:scale(0);opacity:0;background:#0a1626;transition:transform .32s cubic-bezier(.3,1.7,.5,1) .1s,opacity .1s .1s}
.tc.rev .f{transform:scale(0);opacity:0;animation:none}
.tc.rev .b{transform:scale(1);opacity:1}
.tc.rev.dim .b{opacity:.55}
.tc.bomb .b{background:#2a1220}
.tc.boom .b{background:#3a1220;animation:tboom .5s ease-out 2}
@keyframes tboom{50%{filter:brightness(1.9)}}
.tc .b svg{height:clamp(22px,4.4vw,32px);width:clamp(22px,4.4vw,32px);overflow:visible;display:block}
.tc:disabled{cursor:default}
.tpop{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) scale(.6);opacity:0;pointer-events:none;z-index:5;background:rgba(10,17,36,.94);border:2px solid var(--gold);border-radius:18px;padding:16px 26px;text-align:center;box-shadow:0 0 50px rgba(255,200,61,.3),0 20px 50px rgba(0,0,0,.5);transition:transform .32s cubic-bezier(.3,1.5,.5,1),opacity .2s}
.tpop.show{opacity:1;transform:translate(-50%,-50%) scale(1)}
.tpop b{display:block;font-family:var(--f-display);font-weight:900;font-size:clamp(28px,6vw,44px);color:var(--gold);line-height:1.05}
.tpop span{font-family:var(--f-mono);font-weight:700;font-size:16px;color:var(--gem)}
.tdiff button{font-size:12px;padding:10px 2px}
.trand{background:transparent;border:1px dashed var(--line);border-radius:12px;padding:11px;font-weight:800;color:var(--mute);transition:.15s}
.trand:hover:not(:disabled){color:var(--fg);border-color:var(--gem2)}
.trand:disabled{opacity:.5}
@@PARAMS
      <div class="field">
        <span class="lbl">Difficulté</span>
        <div class="seg tdiff" id="diff" role="group" aria-label="Difficulté"><button type="button" data-v="0">Facile</button><button type="button" data-v="1">Moyen</button><button type="button" data-v="2">Difficile</button><button type="button" data-v="3">Expert</button><button type="button" data-v="4">Maître</button></div>
        <p class="hint" id="diffhint"></p>
      </div>
      <button class="trand" id="trand" type="button">Case au hasard</button>
@@AUTO
@@STAGE
      <p class="status" id="status" aria-live="polite">Mise puis grimpe étage par étage, ou présélectionne une case par étage.</p>
      <div class="twrap">
        <div class="tower pre" id="tower" role="group" aria-label="Tour de 9 étages"></div>
        <div class="tpop" id="tpop" aria-live="polite"><b id="tpm">×1,00</b><span id="tpp">+0,00</span></div>
      </div>
@@JS
/* ================= TOWER ================= */
const ROWS=9;
const DIFF=[{n:'Facile',cols:4,good:3},{n:'Moyen',cols:3,good:2},{n:'Difficile',cols:2,good:1},{n:'Expert',cols:3,good:1},{n:'Maître',cols:4,good:1}];
const GEM='<svg viewBox="0 0 64 64" aria-hidden="true"><polygon points="18,12 46,12 60,26 32,58 4,26" fill="#2cf0c2"/><polygon points="18,12 32,26 4,26" fill="#7ffbe3"/><polygon points="46,12 60,26 32,26" fill="#1fb5b0"/><polygon points="4,26 32,26 32,58" fill="#1fb5b0" opacity=".55"/></svg>';
const BOMB='<svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="30" cy="38" r="19" fill="#3a4a6c"/><circle cx="24" cy="32" r="5" fill="#fff" opacity=".22"/><path d="M42 22 l6 -6" stroke="#c8a24b" stroke-width="4" stroke-linecap="round"/><circle cx="50" cy="13" r="4" fill="#ffc83d"/></svg>';
const T={ d:(store.d>=0&&store.d<5)?store.d:1, state:'idle', bad:[], level:0, bet:0, sel:new Array(ROWS).fill(-1), locked:false, autoGen:false };
const tower=$('#tower'), cells=[], rows=[];
let busyUntil=0;
function status(h){ $('#status').innerHTML=h; }
const cfg=()=>DIFF[T.d];
const mult=k=>k<=0?1:Math.floor(.99*Math.pow(cfg().cols/cfg().good,k)*100)/100;
const lab=m=>(m>=1000?Math.round(m).toLocaleString('fr-FR'):m>=100?m.toFixed(0):m.toFixed(2).replace('.',','))+'×';
function buildTower(){
  tower.innerHTML=''; cells.length=0; rows.length=0; const c=cfg();
  for(let r=0;r<ROWS;r++){
    const row=document.createElement('div'); row.className='trow';
    row.innerHTML='<div class="tlab"></div><div class="tcells" style="--cols:'+c.cols+'"></div>';
    row.querySelector('.tlab').textContent=lab(mult(r+1));
    const wrapC=row.querySelector('.tcells'); cells[r]=[];
    for(let j=0;j<c.cols;j++){ const b=document.createElement('button'); b.type='button'; b.className='tc'; b.setAttribute('aria-label','Étage '+(r+1)+', case '+(j+1)); b.innerHTML='<span class="f"></span><span class="b"></span>'; b.addEventListener('click',()=>onCell(r,j)); wrapC.appendChild(b); cells[r][j]=b; }
    tower.appendChild(row); rows[r]=row;
  }
  $('#diffhint').textContent=c.good+' bonne'+(c.good>1?'s':'')+' case'+(c.good>1?'s':'')+' sur '+c.cols+' à chaque étage · sommet '+lab(mult(ROWS));
  T.sel.fill(-1); paintSel(); marks();
}
function selCount(){ let k=0; while(k<ROWS&&T.sel[k]>=0) k++; return k; }
function paintSel(){ for(let r=0;r<ROWS;r++) cells[r].forEach((b,j)=>b.classList.toggle('sel',T.sel[r]===j&&!b.classList.contains('rev'))); }
function marks(){
  for(let r=0;r<ROWS;r++){ const row=rows[r]; row.classList.toggle('done',T.state!=='idle'&&r<T.level); row.classList.toggle('next',T.state==='playing'&&r===T.level); row.classList.toggle('live',T.state==='playing'&&r===T.level); }
  tower.classList.toggle('pre',T.state!=='playing'&&T.state!=='resolving');
  for(let r=0;r<ROWS;r++) cells[r].forEach(b=>{ b.disabled=T.state==='resolving'||(T.state==='playing'&&r!==T.level)||T.locked; });
  applyLock();
}
function selStatus(){ const k=selCount(); status(k?k+' étage'+(k>1?'s':'')+' présélectionné'+(k>1?'s':'')+' · '+lab(mult(k))+' si tout passe':'Mise puis grimpe étage par étage, ou présélectionne une case par étage.'); }
function clearSel(){ T.sel.fill(-1); T.autoGen=false; paintSel(); }
function resetTower(){ $('#tpop').classList.remove('show'); for(let r=0;r<ROWS;r++) cells[r].forEach(b=>{ b.classList.remove('rev','dim','bomb','boom','gem'); b.querySelector('.b').innerHTML=''; }); T.state='idle'; T.level=0; marks(); paintSel(); }
function reveal(r,j,kind,dim){ const b=cells[r][j]; b.querySelector('.b').innerHTML=kind==='bomb'?BOMB:GEM; b.classList.add('rev',kind); if(dim) b.classList.add('dim'); b.classList.remove('sel'); }
function revealAll(){ for(let r=0;r<ROWS;r++) for(let j=0;j<cfg().cols;j++){ if(cells[r][j].classList.contains('rev')) continue; reveal(r,j,T.bad[r].has(j)?'bomb':'gem',true); } }
function placeBombs(){ const c=cfg(); T.bad=[]; for(let r=0;r<ROWS;r++){ const a=[...Array(c.cols).keys()]; for(let i=a.length-1;i>0;i--){ const j=Math.floor(rnd()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } T.bad.push(new Set(a.slice(0,c.cols-c.good))); } }

function onCell(r,j){
  if(T.locked||T.state==='resolving') return;
  if(T.state==='playing'){ if(r===T.level) pick(j); return; }
  if(performance.now()<busyUntil) return;
  if(T.state==='over') resetTower();
  T.autoGen=false;
  if(T.sel[r]===j){ for(let k=r;k<ROWS;k++) T.sel[k]=-1; sfx.tone(300,.08,{type:'triangle',v:.08,slide:.6}); }
  else if(r===0||T.sel[r-1]>=0){ T.sel[r]=j; sfx.thump(r,.55); }
  else { sfx.tick(200,.05); status('Présélectionne en partant du bas, un étage après l’autre.'); return; }
  paintSel(); selStatus(); refresh();
}
function start(){
  if(T.state==='playing'||T.state==='resolving') return null;
  const b=takeBet(); if(!b){ refresh(); return null; }
  T.bet=b; resetTower(); placeBombs();
  const k=selCount();
  if(k){ T.state='resolving'; marks(); refresh(); status('Ascension…'); return wave(k); }
  T.state='playing'; T.level=0; marks(); refresh(); sfx.whoosh(); status('Choisis une case au 1er étage.');
  return new Promise(r=>T.resolve=r);
}
async function wave(k){
  const step=auto?150:260;
  await wait(120);
  for(let r=0;r<k;r++){
    const j=T.sel[r];
    if(T.bad[r].has(j)){ reveal(r,j,'bomb'); cells[r][j].classList.add('boom'); T.level=r; await wait(120); lose(); return; }
    reveal(r,j,'gem'); T.level=r+1; sfx.thump(Math.min(11,r+1)); marks(); vib(10);
    await wait(step);
  }
  win(k);
}
function pick(j){
  const r=T.level;
  if(T.bad[r].has(j)){ reveal(r,j,'bomb'); cells[r][j].classList.add('boom'); lose(); return; }
  reveal(r,j,'gem'); T.level=r+1; sfx.thump(Math.min(11,r+1)); vib(10);
  status('Étage '+(r+1)+' · '+lab(mult(r+1))+' · gain '+fmt(T.bet*mult(r+1)));
  marks(); refresh();
  if(T.level>=ROWS) setTimeout(()=>cashout(),350);
}
function lose(){
  sfx.boom(); flash('red'); shake($('#stage')); vib([60,40,120]);
  setTimeout(revealAll,280);
  settle(T.bet,0); hist('0,00×',false); status('Boum ! −'+fmt(T.bet));
  finish();
}
function win(k){
  const m=mult(k), pay=settle(T.bet,m);
  revealAll(); hist(lab(m),true);
  $('#tpm').textContent=lab(m); $('#tpp').textContent='+'+fmt(pay); $('#tpop').classList.add('show');
  const tier=m<2?0:m<5?1:m<20?2:3; sfx.thump(Math.min(11,k+2)); sfx.win(tier); if(m>=5) flash('gold'); vib([20,20,40]);
  status((k>=ROWS?'Sommet atteint ! ':'Encaissé ! ')+lab(m)+' · <b'+(m>=5?' class="g"':'')+'>+'+fmt(pay)+'</b>');
  finish();
}
function cashout(){ if(T.state!=='playing'||T.level<1) return; win(T.level); }
function finish(){
  T.state='over'; busyUntil=performance.now()+200;
  if(!auto||T.clearAfter) clearSel(); T.clearAfter=false;
  marks(); lock(auto); refresh();
  const r=T.resolve; T.resolve=null; r&&r();
}
function randomCell(){
  if(T.locked||T.state==='resolving') return;
  const c=cfg().cols, j=Math.floor(rnd()*c);
  if(T.state==='playing'){ pick(j); return; }
  if(performance.now()<busyUntil) return;
  if(T.state==='over') resetTower();
  const k=selCount(); if(k>=ROWS) return; T.autoGen=false; T.sel[k]=j; sfx.thump(k,.55); paintSel(); selStatus(); refresh();
}
$('#trand').addEventListener('click',randomCell);
document.addEventListener('keydown',e=>{ if(e.target&&e.target.tagName==='INPUT') return; if(e.key==='r'||e.key==='R') randomCell(); });
function diffSync(){ document.querySelectorAll('#diff button').forEach(b=>b.setAttribute('aria-pressed',String(+b.dataset.v===T.d))); }
function applyLock(){ const d=T.locked||T.state==='playing'||T.state==='resolving'; document.querySelectorAll('#diff button').forEach(b=>b.disabled=d); $('#trand').disabled=T.locked||T.state==='resolving'; }
$('#diff').addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b||b.disabled) return; T.d=+b.dataset.v; diffSync(); sfx.ui(); T.state='idle'; buildTower(); selStatus(); refresh(); save(); });

const G={
  main(){ if(T.state==='playing'){ cashout(); return; } start(); },
  cta(){ if(T.state==='resolving') return {label:'Ascension…',disabled:true}; if(T.state==='playing') return T.level<1?{label:'Choisis une case',disabled:true}:{label:'Encaisser '+fmt(T.bet*mult(T.level)),cls:'cash'}; return {label:'Miser'}; },
  busy:()=>T.state==='playing'||T.state==='resolving',
  autoReady(show){ const ok=selCount()>0; if(!ok&&show) status('Présélectionne au moins un étage (en partant du bas) pour l’auto.'); return ok; },
  autoStep(){ return start()||Promise.resolve(); },
  autoGap:()=>900,
  lock(l){ T.locked=l; applyLock(); marks(); },
  onStop(){ if(T.state!=='playing'&&T.state!=='resolving'){ clearSel(); if(T.state==='idle') selStatus(); } else T.clearAfter=true; },
  saveState:()=>({d:T.d}),
  status
};
diffSync(); buildTower(); kitInit();
